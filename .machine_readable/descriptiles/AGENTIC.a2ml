#
# AGENTIC.a2ml — AI agent constraints and capabilities
name = "agentic"

[metadata]
version = "0.1.0"
last-updated = "2026-04-11"

[agent-permissions]
can-edit-source = true
can-edit-tests = true
can-edit-docs = true
can-edit-config = true
can-create-files = true

[agent-constraints]
# What AI agents must NOT do:
# - Never use banned language patterns (believe_me, unsafeCoerce, etc.)
# - Never commit secrets or credentials
# - Never use banned languages (TypeScript, Python, Go, etc.)
# - Never place state files in repository root (must be in .machine_readable/)
# - Never relicense an existing file, and never run an automated licence
#   sweep (LICENCE-POLICY.adoc A2). New files get correct SPDX from birth.
# - Never assume a licence. Read standards/LICENCE-POLICY.adoc: Rule 1
#   defaults to MPL-2.0 (code) / CC-BY-SA-4.0 (prose), but Rule 3
#   (co-developed), Rule 4 (network-deployed services) and Rule 5
#   (games) are AGPL-3.0-or-later, and Rule 2 names the PMPL register.

[maintenance-integrity]
fail-closed = true
require-evidence-per-step = true
allow-silent-skip = false
require-rerun-after-fix = true
release-claim-requires-hard-pass = true

[workflow-pin-remediation]
# The fleet's half of the pin-propagation architecture
#   hypatia (detection) -> gitbot-fleet (this: actuation) -> .git-private-farm (propagation)
# Three fix scripts, one contract test (scripts/tests/fix-workflow-pins.sh, run
# by rust.yml), and two data files that carry the SAME facts hypatia detects
# on, so detection and repair cannot drift apart:
#   scripts/fix-rust-toolchain-input.sh   WF026  SHA-pinned dtolnay/rust-toolchain with no toolchain: input
#   scripts/fix-stale-reusable-pin.sh     WF027, PIN-003  a caller pinned at a reusable revision the estate has MEASURED dead
#                                         (not WF016: its orphan SHAs have no recorded replacement in the table)
#   scripts/fix-lock-self-sha-refs.sh     PI006  actions.lock record whose ref is its own SHA (GitHub: "invalid lockfile pin")
#   scripts/lib/stale-reusable-pins.tsv   the dead revisions and the one replacement each moves to
#   scripts/lib/action-ref-tags.tsv       the tag that resolves to each commit the estate pins by SHA
may-rewrite-reusable-pins = true           # only to a replacement the table names; never "newest"
may-rewrite-actions-lock = true            # SHA substitution and ref:tag only; nested uses: lists are never recomputed here
may-choose-replacement-sha = false         # a human picks it against standards/scripts/lock-selfcheck.sh and records it in the table
may-run-network-lookups = true             # git ls-remote --tags for a tag the map lacks; --offline disables it
must-report-unresolved = true              # a self-SHA record with no tag is reported and left, never guessed (exit 1)
must-be-idempotent = true                  # every script's second run is byte-identical; the contract test asserts it

[automation-hooks]
# on-enter: Read 0-AI-MANIFEST.a2ml, then .machine_readable/descriptiles/STATE.a2ml
# on-exit: Update .machine_readable/descriptiles/STATE.a2ml with session outcomes
# on-commit: Run just validate-rsr
