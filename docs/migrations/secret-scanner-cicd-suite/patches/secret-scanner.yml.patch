 name: Secret Scanner
 
+# Consumer migration to the published cicd-suite scanner. The three contexts
+# this repository's rulesets require — scan / gitleaks, scan / rust-secrets,
+# scan / shell-secrets — are produced by the callee's gitleaks job and by its
+# supplemental-results matrix; none is renamed, added or dropped here.
+#
+# Boundaries, all enforced by preflight.sh:
+#   * `fast-pr` stays false: non-PR runs scan full history, and introduced-commit
+#     PR scanning is not enabled before the security owner accepts it.
+#   * No `secrets:` line. The callee declares no workflow_call secret and the
+#     scanner installs its own checksum-pinned binary, so `secrets: inherit`
+#     would forward every repository and organisation secret for no benefit.
+#   * `contents: read` is the whole grant; the previous caller's
+#     security-events / pull-requests / actions grants are not carried over.
+#   * Triggers are unchanged: pull_request and push to main, nothing else.
+
 on:
   pull_request:
   push:
@@ -14,15 +27,19 @@
   cancel-in-progress: true
 
 permissions:
-  actions: read
   contents: read
 
 jobs:
   scan:
+    # This job-level block REPLACES the workflow-level one. `contents: read` is
+    # the complete grant the callee's jobs declare; granting more is needless
+    # authority, granting less rejects the run at startup with zero jobs.
     permissions:
-      security-events: write
       contents: read
-      pull-requests: write
-      actions: read
-    uses: hyperpolymath/standards/.github/workflows/secret-scanner-reusable.yml@75bd5994470661a099df562d6d5ad2fe744dbd66
-    # secret-scanner-reusable declares no caller secret, so none is passed.
