+    with:
+      # Keep false until the unified-dataset-vocab live canary has passed and
+      # the security owner accepts introduced-commit PR coverage. Every non-PR
+      # run remains a full-history scan.
+      fast-pr: false
+    # Deliberately no `secrets:` line — see the boundary note above.
